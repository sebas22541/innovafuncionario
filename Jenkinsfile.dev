pipeline {
    agent { label 'server_104.64' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        DOCKER_COMPOSE_FILE = 'docker-compose-dev.yml'
        GIT_URL = 'https://github.com/alcaldiacochabamba/innovafuncionario.cochabamba.bo.git'
        GIT_CREDENTIALS = 'github-https'
        GIT_BRANCH = 'dev'
        DOCKER_BUILDKIT = '1'
        COMPOSE_DOCKER_CLI_BUILD = '1'
        BUILDKIT_PROGRESS = 'plain'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: env.GIT_BRANCH, credentialsId: env.GIT_CREDENTIALS, url: env.GIT_URL
            }
        }

        stage('Stop old containers') {
            steps {
                sh "docker-compose --env-file backend/.env.dev -f ${env.DOCKER_COMPOSE_FILE} down --remove-orphans"
            }
        }

        stage('Build') {
            steps {
                sh "docker-compose --env-file backend/.env.dev -f ${env.DOCKER_COMPOSE_FILE} build --parallel"
            }
        }

        stage('Deploy') {
            steps {
                sh "docker-compose --env-file backend/.env.dev -f ${env.DOCKER_COMPOSE_FILE} up -d --remove-orphans"
            }
        }
    }

    post {
        failure {
            sh "docker-compose --env-file backend/.env.dev -f ${env.DOCKER_COMPOSE_FILE} ps"
        }
    }
}
