# Configurar en las variables de Production y Preview del proyecto Vercel.
# Los archivos .env.prod no se cargan automaticamente en Vercel.
NODE_ENV=production
DATABASE_URL=
# Usar el mismo JWT_SECRET que la API de respaldo para compartir sesiones.
JWT_SECRET=
JWT_TTL_SECONDS=900
# Debe coincidir con la clave incorporada a la compilacion iOS.
PAYLOAD_ENCRYPTION_KEY=
PAYLOAD_RESPONSE_ENCRYPTION=true
APP_TIME_ZONE=America/La_Paz
CORS_ALLOWED_ORIGINS=https://innovafuncionario.cochabamba.bo,https://soygamc.cochabamba.bo,https://innovafuncionariodev.cochabamba.bo
DB_POOL_MAX=5
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Deben coincidir con la API de respaldo para validar los mismos QR.
QR_DYNAMIC_SECRET=
CALIFICACION_QR_SECRET=
APPLE_BUNDLE_ID=com.innovafuncionario.gamc.bo
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
